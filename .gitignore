node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*

# Generated by scripts/vendor-assets.mjs from src/styles/site.css on prebuild,
# under a content-hashed filename (site.<hash>.css). Served from public/ so
# Astro never inlines it, which the CSP forbids.
/public/styles/

# Build-only Onest TTF buffers scripts/render-og.mjs needs (converted from
# the pinned @fontsource/onest WOFF1 entries by scripts/vendor-assets.mjs).
# Never served -- resvg-wasm reads them directly off disk at build time.
/scripts/fonts/
