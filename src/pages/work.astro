---
import Base from '../layouts/Base.astro';
import Lang from '../i18n/Lang.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { ui } from '../i18n/ui';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const en = all.filter((entry) => entry.data.lang === 'en');
const ru = new Map(
  all.filter((entry) => entry.data.lang === 'ru').map((entry) => [entry.data.slug, entry]),
);
const inGroup = (group: 'platform' | 'product') =>
  en
    .filter((entry) => entry.data.group === group)
    .sort((a, b) => a.data.order - b.data.order);

const platform = inGroup('platform');
const products = inGroup('product');
---

<Base
  title={ui.workPageTitle.en}
  description="Platform services and products built through the DevLoop, each with its stack, its repository and the snapshot metrics behind it."
>
  <main>
    <h1><Lang en={ui.navWork.en} ru={ui.navWork.ru} /></h1>

    <section class="work-group">
      <h2><Lang en={ui.workGroupPlatform.en} ru={ui.workGroupPlatform.ru} /></h2>
      {platform.map((entry) => (
        <ProjectCard en={entry} ru={ru.get(entry.data.slug)!} />
      ))}
    </section>

    <section class="work-group">
      <h2><Lang en={ui.workGroupProducts.en} ru={ui.workGroupProducts.ru} /></h2>
      {products.map((entry) => (
        <ProjectCard en={entry} ru={ru.get(entry.data.slug)!} />
      ))}
    </section>
  </main>
</Base>
