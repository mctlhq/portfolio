---
import Base from '../layouts/Base.astro';
import Lang from '../i18n/Lang.astro';
import { ui } from '../i18n/ui';
---

<Base title={`${ui.notFoundTitle.en} / ${ui.notFoundTitle.ru}`}>
  <main>
    <h1><Lang en={ui.notFoundTitle.en} ru={ui.notFoundTitle.ru} /></h1>
    <p><Lang en={ui.notFoundBody.en} ru={ui.notFoundBody.ru} /></p>
    <p><a href="/"><Lang en={ui.notFoundHome.en} ru={ui.notFoundHome.ru} /></a></p>
  </main>
</Base>
