---
import Base from '../../../layouts/Base.astro';
import Lang from '../../../i18n/Lang.astro';
import { ui } from '../../../i18n/ui';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { publicEntries } from '../../../lib/content';
import { padAdrId } from '../../../lib/adr';

export async function getStaticPaths() {
  const entries = publicEntries(await getCollection('adr'));
  const byId = new Map(entries.map((entry) => [entry.data.id, entry]));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      supersededEntry: entry.data.supersedes !== undefined ? byId.get(entry.data.supersedes) : undefined,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'adr'>;
  supersededEntry: CollectionEntry<'adr'> | undefined;
}

const { entry, supersededEntry } = Astro.props as Props;
const { Content } = await render(entry);

const adrStatusLabel = {
  proposed: ui.adrStatusProposed,
  accepted: ui.adrStatusAccepted,
  superseded: ui.adrStatusSuperseded,
  deprecated: ui.adrStatusDeprecated,
} as const;
const statusLabel = adrStatusLabel[entry.data.status];
---

<Base title={`ADR-${padAdrId(entry.data.id)}: ${entry.data.title.en} — Dmitrii Mashkov`}>
  <main>
    <h1>ADR-{padAdrId(entry.data.id)}: <Lang en={entry.data.title.en} ru={entry.data.title.ru} /></h1>
    <p class="adr-meta">
      <Lang en={statusLabel.en} ru={statusLabel.ru} /> · {entry.data.date}
    </p>
    {supersededEntry && (
      <p class="adr-meta">
        <Lang en={ui.adrSupersedesLabel.en} ru={ui.adrSupersedesLabel.ru} />{': '}
        <a href={`/colophon/adr/${supersededEntry.id}/`}>
          ADR-{padAdrId(supersededEntry.data.id)}
        </a>
      </p>
    )}

    <div class="mctl-prose">
      <Content />
    </div>

    <p><a href="/colophon/"><Lang en={ui.adrBackToColophon.en} ru={ui.adrBackToColophon.ru} /></a></p>
  </main>
</Base>
