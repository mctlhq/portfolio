---
import Base from '../layouts/Base.astro';
import Lang from '../i18n/Lang.astro';
import Stat from '../components/Stat.astro';
import Details from '../components/Details.astro';
import { ui } from '../i18n/ui';
import { snapshotDate, type Metrics } from '../lib/metrics';
import raw from '../data/metrics.json';

const metrics = raw as Metrics;
const date = snapshotDate(metrics.generated_at);
---

<Base
  title={ui.homeTitle.en}
  description="Platform engineering with AI on proven open source. Dmitrii Mashkov builds and runs an internal developer platform where agents ship and humans hold the gates."
>
  <span class="eyebrow"><Lang en={ui.heroEyebrow.en} ru={ui.heroEyebrow.ru} /></span>
  <h1 class="hero-name"><Lang en={ui.heroName.en} ru={ui.heroName.ru} /></h1>
  <p class="thesis"><Lang en={ui.heroThesis.en} ru={ui.heroThesis.ru} /></p>
  <p class="subline"><Lang en={ui.heroSubline.en} ru={ui.heroSubline.ru} /></p>

  <span id="ctas-label" class="visually-hidden"><Lang en={ui.ctasLabel.en} ru={ui.ctasLabel.ru} /></span>
  <nav class="ctas" aria-labelledby="ctas-label">
    <a class="cta cta-primary" href="#contact"><Lang en={ui.ctaContact.en} ru={ui.ctaContact.ru} /></a>
    <a class="cta" href="/work/"><Lang en={ui.ctaWork.en} ru={ui.ctaWork.ru} /></a>
  </nav>

  <section id="about">
    <h2><Lang en={ui.aboutHeading.en} ru={ui.aboutHeading.ru} /></h2>
    {ui.aboutParagraphs.en.map((paragraph, index) => (
      <p><Lang en={paragraph} ru={ui.aboutParagraphs.ru[index]} /></p>
    ))}
  </section>

  <section id="capabilities">
    <h2><Lang en={ui.capabilitiesHeading.en} ru={ui.capabilitiesHeading.ru} /></h2>
    <div class="capability-list">
      {ui.capabilityItems.en.map((item, index) => (
        <>
          <h3><Lang en={item.term} ru={ui.capabilityItems.ru[index].term} /></h3>
          <p><Lang en={item.body} ru={ui.capabilityItems.ru[index].body} /></p>
        </>
      ))}
    </div>
  </section>

  <section class="stats">
    <Stat value={metrics.sources.github.repos} labelEn={ui.statRepositories.en} labelRu={ui.statRepositories.ru} />
    <Stat value={metrics.sources.github.commits} labelEn={ui.statCommits.en} labelRu={ui.statCommits.ru} />
    <Stat value={metrics.sources.github.releases} labelEn={ui.statReleases.en} labelRu={ui.statReleases.ru} />
    <Stat value={metrics.sources.mctl.services} labelEn={ui.statServices.en} labelRu={ui.statServices.ru} />
    <p class="stat-caption">
      <Lang en={`${ui.statCaptionPrefix.en} ${date}`} ru={`${ui.statCaptionPrefix.ru} ${date}`} />
    </p>
  </section>

  <Details summaryEn={ui.detailsRunSummary.en} summaryRu={ui.detailsRunSummary.ru} heading>
    <ul class="l en">
      {ui.detailsRunItems.en.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="l ru" lang="ru">
      {ui.detailsRunItems.ru.map((item) => <li>{item}</li>)}
    </ul>
  </Details>

  <Details summaryEn={ui.detailsWorkSummary.en} summaryRu={ui.detailsWorkSummary.ru} heading>
    <ul class="l en">
      {ui.detailsWorkItems.en.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="l ru" lang="ru">
      {ui.detailsWorkItems.ru.map((item) => <li>{item}</li>)}
    </ul>
  </Details>

  <section id="contact">
    <h2><Lang en={ui.contactHeading.en} ru={ui.contactHeading.ru} /></h2>
    <p><Lang en={ui.contactIntro.en} ru={ui.contactIntro.ru} /></p>
    <ul class="contact-list">
      {ui.contactItems.en.map((item, index) => (
        <li>
          <Lang en={item.label} ru={ui.contactItems.ru[index].label} />:{' '}
          <a href={item.href}><Lang en={item.text} ru={item.text} /></a>
        </li>
      ))}
    </ul>
  </section>
</Base>
