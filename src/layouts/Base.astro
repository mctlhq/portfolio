---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lang from '../i18n/Lang.astro';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.svg', Astro.site);
---

<html lang="en" data-lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>let d=document.documentElement,A=(k,v)=>{d.dataset[k]=v;k=="lang"&&(d.lang=v)};try{let s=localStorage;s.lang&&A("lang",s.lang);s.theme&&A("theme",s.theme)}catch{}addEventListener("click",e=>{let b=e.target.closest?.("[data-set-lang],[data-set-theme]"),k=b&&(b.dataset.setLang?"lang":"theme"),v=b&&(b.dataset.setLang||b.dataset.setTheme);if(k){A(k,v);try{localStorage[k]=v}catch{}}})</script>
    <link rel="stylesheet" href="/assets/mctl/mctl.css" />
    <link rel="stylesheet" href="/assets/mctl/global.css" />
    <link rel="stylesheet" href="/assets/mctl/prose.css" />
    <link rel="stylesheet" href="/assets/fonts/fonts.css" />
    <link rel="stylesheet" href="/styles/site.css" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl.href} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dmitrii Mashkov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
  </head>
  <body>
    <a class="skip-link" href="#main"><Lang en={ui.skipToContent.en} ru={ui.skipToContent.ru} /></a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
