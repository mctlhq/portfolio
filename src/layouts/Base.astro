---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lang from '../i18n/Lang.astro';
import { ui } from '../i18n/ui';
import assets from '../data/assets.json';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  robots?: string;
  jsonLd?: unknown;
}

const { title, description, noindex = false, robots, jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.png', Astro.site);
// The image itself (public/og.svg) renders "Dmitrii Mashkov", "Platform
// engineering with AI on proven open source" and "dmitriimashkov.com" in
// Latin regardless of the reader's toggle, so this alt text is English on
// every page.
const OG_IMAGE_ALT = 'Dmitrii Mashkov — platform engineering with AI on proven open source, dmitriimashkov.com';
---

<html lang="en" data-lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Four preloads, not two. The `is:inline` script below applies
        `localStorage.lang` before the body paints, so a returning Russian
        reader paints Cyrillic on the first frame -- for that reader the
        cyrillic faces are the needed pair and latin is the wasted one.
        Which two are wasted is a property of the reader, not of the build.
        Preloading latin only would move the font swap this cycle exists to
        eliminate onto every Russian reader, half the audience of a
        deliberately bilingual site. Reviewed and rejected on #64; do not
        re-litigate without changing that script. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={assets.preload.onestLatin400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={assets.preload.onestLatin700} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={assets.preload.onestCyrillic400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={assets.preload.onestCyrillic700} />
    <script is:inline>let d=document.documentElement,A=(k,v)=>{d.dataset[k]=v;k=="lang"&&(d.lang=v)};try{let s=localStorage;s.lang&&A("lang",s.lang);s.theme&&A("theme",s.theme)}catch{}addEventListener("click",e=>{let b=e.target.closest?.("[data-set-lang],[data-set-theme]"),k=b&&(b.dataset.setLang?"lang":"theme"),v=b&&(b.dataset.setLang||b.dataset.setTheme);if(k){A(k,v);try{localStorage[k]=v}catch{}}})</script>
    {assets.styles.map((href: string) => <link rel="stylesheet" href={href} />)}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl.href} />
        {robots && <meta name="robots" content={robots} />}
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dmitrii Mashkov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main"><Lang en={ui.skipToContent.en} ru={ui.skipToContent.ru} /></a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
