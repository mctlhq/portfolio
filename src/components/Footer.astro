---
import Lang from '../i18n/Lang.astro';
import { ui } from '../i18n/ui';
import pkg from '../../package.json';

// The release value has no build-arg / git-describe source wired up yet
// (tracked for a later issue); package.json's version is a stable
// stand-in behind the data-release hook so that later issue can swap the
// source without touching this markup.
---

<footer class="site-footer">
  <a href="https://github.com/mctlhq">
    <Lang en={ui.footerGithubLabel.en} ru={ui.footerGithubLabel.ru} />
  </a>
  <span>
    <Lang en={ui.footerReleaseLabel.en} ru={ui.footerReleaseLabel.ru} />:
    <span data-release>{pkg.version}</span>
  </span>
</footer>
