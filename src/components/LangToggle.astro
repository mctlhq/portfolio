---
import Lang from '../i18n/Lang.astro';
import { ui } from '../i18n/ui';
---

<div class="toggle-group l en" role="group" aria-labelledby="lang-toggle-label">
  <button type="button" data-set-lang="en" aria-pressed="true">
    <Lang en={ui.langEn.en} ru={ui.langEn.ru} />
  </button>
  <button type="button" data-set-lang="ru" aria-pressed="false">
    <Lang en={ui.langRu.en} ru={ui.langRu.ru} />
  </button>
</div>
<div class="toggle-group l ru" role="group" aria-labelledby="lang-toggle-label">
  <button type="button" data-set-lang="en" aria-pressed="false">
    <Lang en={ui.langEn.en} ru={ui.langEn.ru} />
  </button>
  <button type="button" data-set-lang="ru" aria-pressed="true">
    <Lang en={ui.langRu.en} ru={ui.langRu.ru} />
  </button>
</div>
<span id="lang-toggle-label" class="visually-hidden"><Lang en={ui.langToggleLabel.en} ru={ui.langToggleLabel.ru} /></span>
<noscript>
  <p><Lang en={ui.langNoScript.en} ru={ui.langNoScript.ru} /></p>
</noscript>
