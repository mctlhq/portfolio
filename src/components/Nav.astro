---
import Lang from '../i18n/Lang.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ui } from '../i18n/ui';

const navLabel = `${ui.navLabel.en} / ${ui.navLabel.ru}`;
---

<header class="site-header">
  <nav class="site-nav" aria-label={navLabel}>
    <a href="/"><Lang en={ui.navHome.en} ru={ui.navHome.ru} /></a>
    <a href="/work/"><Lang en={ui.navWork.en} ru={ui.navWork.ru} /></a>
    <a href="/#approach"><Lang en={ui.navApproach.en} ru={ui.navApproach.ru} /></a>
  </nav>
  <LangToggle />
  <ThemeToggle />
</header>
