---
import Lang from '../i18n/Lang.astro';

interface Props {
  summaryEn: string;
  summaryRu: string;
  open?: boolean;
}

const { summaryEn, summaryRu, open = false } = Astro.props;
---

<details class="block" open={open}>
  <summary><Lang en={summaryEn} ru={summaryRu} /></summary>
  <slot />
</details>
